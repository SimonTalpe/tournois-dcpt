# Copier ce fichier en .env.local (jamais versionné) pour un usage local.
# En ligne, ces valeurs se renseignent dans les réglages du projet Cloudflare Pages.
# Ces deux valeurs sont « publiques » (clé anon) : la sécurité est assurée par les règles de la base.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
